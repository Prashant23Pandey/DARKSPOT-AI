# ==============================================================================
# DARKSPOT AI - Environment Variables Template
# Shinchan Online Hackathon 2026 - Digital Dark Spot Platform
# ==============================================================================

# Core Intelligence Engine (Google Gemini API)
# Required for live LLM-based gap extraction, conflict resolution, and checklist synthesis.
# If omitted or invalid, the engine operates in realistic offline Blueprint / Mock mode.
GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
NEXT_PUBLIC_APP_NAME="DARKSPOT AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Supabase Ready Architecture (Optional / Connect your Supabase project)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Optional Permitted Search Integration (Tavily or SerpApi)
# If omitted, manual URL input and sample benchmark modes are used. Never invents search results.
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Safe Extraction Settings
ENABLE_LIVE_SCRAPING=true
EXTRACTION_TIMEOUT_MS=8500
